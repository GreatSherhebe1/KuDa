@page
@{
    var today = DateTime.Now;
    var daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);

    var firstDayOfMonth = new DateTime(today.Year, today.Month, 1);
    var startOffset = ((int)firstDayOfMonth.DayOfWeek + 6) % 7;
    var totalCells = daysInMonth + startOffset;
    var weekRows = (int)Math.Ceiling(totalCells / 7f);
    var day = 0;
}
@model KuDa.Server.Pages.CalendarModel
@{
    <table>
        <tr>
            <th>ПН</th>
            <th>ВТ</th>
            <th>СР</th>
            <th>ЧТ</th>
            <th>ПТ</th>
            <th>СБ</th>
            <th>ВС</th>
        </tr>
        @for (var row = 0; row < weekRows; row++)
        {
            <tr>
                @for (var column = 0; column < 7; column++)
                {
                    int cellIndex = row * 7 + column;
                    if (cellIndex < startOffset || cellIndex >= totalCells)
                    {
                        // Пустая ячейка до начала месяца или после окончания
                        <th>&nbsp;</th>
                    }
                    else
                    {
                        day++;
                        <th>@day</th>
                    }
                }
            </tr>
        }
    </table>
}
